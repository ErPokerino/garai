# Facoltativo: provider, chiavi e modelli si configurano anche dalla UI (Impostazioni),
# che ha la precedenza e salva in data/settings.json. Copia in .env solo se preferisci le variabili d'ambiente.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# auto (primo provider con chiave: anthropic > openai > gemini) | gemini | anthropic | openai | none
LLM_PROVIDER=auto

# Modello "strong": estrazione bando, parsing CV, scrittura contenuti, critico visivo.
# Modello "fast": abbinamento, verifica di fedelta', traduzione etichette.
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
OPENAI_MODEL_STRONG=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini

# Limiti di spesa in USD (0 = nessun limite)
# RUN_BUDGET_USD=2
# MONTHLY_BUDGET_USD=50

# Accesso (consigliati per la messa online; in locale vengono generati/usati i default)
# GARAI_SECRET_KEY=        chiave lunga e casuale per firmare le sessioni
# GARAI_ADMIN_PASSWORD=    password iniziale dell'utente admin (default: 123), usata solo al primo avvio

# Opzionali
# MAX_FIT_ITERATIONS=2      riscritture LLM se il testo non entra nel template
# MAX_EXPERIENCES=6
# DATA_DIR=data             pratiche, registro costi (garai.db), impostazioni
# LLM_CACHE_DIR=.cache/llm
# OUT_DIR=out               output della CLI
# RENDERER=powerpoint|libreoffice|estimate
